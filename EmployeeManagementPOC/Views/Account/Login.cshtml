@model EmployeeManagementPOC.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand-panel">

            <div class="auth-brand">

                <div class="auth-logo">
                    EM
                </div>

                <div>
                    <div class="auth-brand-title">
                        Employee Management
                    </div>

                    <div class="auth-brand-subtitle">
                        Operations Portal
                    </div>
                </div>

            </div>

            <div class="auth-brand-content">

                <span class="auth-eyebrow">
                    EMPLOYEE MANAGEMENT SYSTEM
                </span>

                <h1>
                    Manage your workforce
                    <span>with confidence.</span>
                </h1>

                <p>
                    Access employee information, departments,
                    dashboards and operational tools from one
                    centralized platform.
                </p>

                <div class="auth-features">

                    <div class="auth-feature">
                        <span class="feature-icon">✓</span>
                        <span>Centralized employee management</span>
                    </div>

                    <div class="auth-feature">
                        <span class="feature-icon">✓</span>
                        <span>Secure role-based access</span>
                    </div>

                    <div class="auth-feature">
                        <span class="feature-icon">✓</span>
                        <span>Real-time operational dashboard</span>
                    </div>

                </div>

            </div>

            <div class="auth-brand-footer">
                Employee Management POC · 2026
            </div>

        </div>

        <div class="auth-form-panel">

            <div class="auth-form-container">

                <div class="auth-form-header">

                    <h2>Welcome back</h2>

                    <p>
                        Sign in to access your account.
                    </p>

                </div>

                <form asp-action="Login"
                      method="post">

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewBag.ReturnUrl" />

                    <div asp-validation-summary="ModelOnly"
                         class="auth-validation">
                    </div>

                    <div class="auth-field">

                        <label asp-for="Email">
                            Email address
                        </label>

                        <input asp-for="Email"
                               class="auth-input"
                               placeholder="name@company.com"
                               autocomplete="username" />

                        <span asp-validation-for="Email"
                              class="auth-field-error">
                        </span>

                    </div>

                    <div class="auth-field">

                        <div class="auth-password-header">

                            <label asp-for="Password">
                                Password
                            </label>

                        </div>

                        <input asp-for="Password"
                               type="password"
                               class="auth-input"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <span asp-validation-for="Password"
                              class="auth-field-error">
                        </span>

                    </div>

                    <div class="auth-options">

                        <label class="auth-checkbox">

                            <input asp-for="RememberMe" />

                            <span>
                                Remember me
                            </span>

                        </label>

                    </div>

                    <button type="submit"
                            class="auth-submit">

                        Sign in

                        <span class="auth-submit-arrow">
                            →
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}